# Copy this file to api/.env for local development.
# The backend expects PostgreSQL locally, so DATABASE_URL should point to a running local database.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,api,frontend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://frontend:5173,http://api:8000
DATABASE_URL=postgres://bordados:bordados@localhost:5432/bordados
